          "other" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer %lld éléments" } }
        } } }
      }
    },
    "Deletion can sync to your other devices and affect Shared Library participants." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除操作可能同步到你的其他设备，也可能影响共享图库的其他参与者。" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La eliminación puede sincronizarse con tus otros dispositivos y afectar a quienes participan en la fototeca compartida." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Löschen kann mit deinen anderen Geräten synchronisiert werden und sich auf andere Personen in der geteilten Mediathek auswirken." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La suppression peut se répercuter sur vos autres appareils et affecter les personnes qui utilisent la photothèque partagée." } }
      }
    },
    "Device restrictions limit photo access." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备限制了照片访问权限。" } },
