    "Favorite. You’ll confirm its removal separately." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这张截屏已收藏，删除时需要单独确认。" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Captura favorita. Tendrás que confirmar su eliminación por separado." } },
