        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Capture en favori. Vous confirmerez sa suppression séparément." } }
      }
    },
    "Favorites selected for removal: %lld. Deletion can sync to other devices and affect Shared Library participants." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所选项目中有 %lld 个收藏项。删除操作可能同步到其他设备，也可能影响共享图库的其他参与者。" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Favoritos que se eliminarán: %lld. La eliminación puede sincronizarse con otros dispositivos y afectar a quienes participan en la fototeca compartida." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zum Löschen ausgewählte Favoriten: %lld. Das Löschen kann sich auf andere Geräte und auf andere Personen in der geteilten Mediathek auswirken." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Favoris à supprimer : %lld. La suppression peut se répercuter sur d’autres appareils et affecter les personnes qui utilisent la photothèque partagée." } }
      }
    },
    "Find screenshots you no longer need. Review them on your iPhone before you delete." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "找出不再需要的截屏，在 iPhone 上查看并确认后再删除。" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Encuentra las capturas que ya no necesitas. Revísalas en tu iPhone antes de eliminarlas." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Finde Screenshots, die du nicht mehr brauchst. Prüfe sie auf deinem iPhone, bevor du sie löschst." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retrouvez les captures d’écran dont vous n’avez plus besoin. Vérifiez-les sur votre iPhone avant de les supprimer." } }
