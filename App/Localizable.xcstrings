    "Manage Photo Access" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "管理照片访问权限" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Gestionar el acceso a las fotos" } },
