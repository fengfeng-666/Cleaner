        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除 %lld 个项目" } },
        "en" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "Delete %lld Item" } },
